# Copy this file to `.env` and fill in the values.
# Everything prefixed VITE_ is bundled into the browser build, so never put secrets here.

# Base URL of the FastAPI backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and publishable (anon) key — Settings > API in the Supabase dashboard
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
